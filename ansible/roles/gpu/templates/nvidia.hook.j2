[Trigger]
Operation=Install
Operation=Upgrade
Operation=Remove
Type=Package
# Match the base driver package
Target={{ gpu.nvidia.hook_target }}
# Match the kernel package
Target=linux

[Action]
Description=Update Nvidia module in initcpio
Depends=mkinitcpio
When=PostTransaction
NeedsTargets
Exec=/bin/sh -c 'while read -r trg; do case $trg in linux) exit 0; esac; done; /usr/bin/mkinitcpio -P'
