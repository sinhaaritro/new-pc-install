---
# Lint policy (ADR-030, ADR-031): these rule classes are satisfied by design,
# so exclude them rather than rename the intentionally cross-role variables or
# add the community.general collection dependency.
# Note: skip_list accepts rule-family IDs; sub-rule IDs (e.g.
# var-naming/no-role-prefix) are not matched, so the family is used.
skip_list:
  - var-naming
  - fqcn[canonical]

# workflow_development/defaults and workflow_ai/defaults carry the spec 002
# roster contract verbatim (module_cli / module_gui / module_defaults + the
# Task 5/6 audit greps). module_defaults is an Ansible reserved name, so the
# vars schema and naming rules are waived for those files only: they are
# linted as plain yaml.
kinds:
  - yaml: "roles/workflow_development/defaults/main.yml"
  - yaml: "roles/workflow_ai/defaults/main.yml"
