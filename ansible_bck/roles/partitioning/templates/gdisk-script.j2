#!/bin/bash
# Generated by the partitioning role (manifest module: partitioning).
# Creates a fresh GPT table on /dev/{{ target_drive }}:
#   1: EFI system partition ({{ efi_size }})
{% if swap | bool %}#   2: Linux swap ({{ swap_size }})
{% endif %}{% if swap | bool %}#   3: Linux filesystem (root, remaining space)
{% else %}#   2: Linux filesystem (root, remaining space)
{% endif %}set -euo pipefail

DEVICE="/dev/{{ target_drive }}"
ROOT_NUM={{ 3 if swap | bool else 2 }}

printf 'o\n' \
  'n\n1\n\n+{{ efi_size }}\n{{ distro_partitioning.efi_code }}\n' \
{% if swap | bool %}  'n\n2\n\n+{{ swap_size }}\n{{ distro_partitioning.swap_code }}\n' \
  'n\n3\n\n\n{{ distro_partitioning.root_code }}\n' \
{% else %}  'n\n2\n\n\n{{ distro_partitioning.root_code }}\n' \
{% endif %}  'w\n' | gdisk "${DEVICE}"

echo "GPT table written to ${DEVICE}"
