# llama.cpp server (written by Play 4, module inference).
# A *service unit definition*, not a user dotfile (spec 006, ADR-011).
# The model preset it loads (~/models/config.ini) is stow-owned.
[Unit]
Description=llama.cpp server (OpenAI-compatible API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/llama-server --models-preset %h/models/config.ini --fit off --models-max 1
Restart=on-failure
RestartSec=10s
Environment=CUDA_VISIBLE_DEVICES={{ inference_cuda_device | default(0) }}

[Install]
WantedBy=default.target
